import numpy as np

def simpson_1_3(f, a, b, n):
    """
    Thuật toán 15: Tính tích phân xác định bằng phương pháp Simpson 1/3.
    
    Đầu vào (Require):
      f : Hàm số cần tính tích phân (callable).
      a : Cận dưới của tích phân (float).
      b : Cận trên của tích phân (float).
      n : Số khoảng chia (int, phải là số chẵn, n >= 2).
      
    Đầu ra (Ensure):
      Giá trị xấp xỉ của tích phân (float).
    """
    # Bước kiểm tra điều kiện biên
    if n % 2 != 0:
        raise ValueError(f"LỖI: Số khoảng chia n = {n} phải là một SỐ CHẴN cho phương pháp Simpson 1/3!")
    if a >= b:
        raise ValueError("LỖI: Cận dưới a phải nhỏ hơn cận trên b!")
        
    # Bắt đầu thuật toán
    h = (b - a) / n  # Dòng 1 - Thuật toán 15
    
    # Khởi tạo các biến tổng tích lũy
    sum1 = 0  # Tổng các vị trí i chẵn (nhân với 2)
    sum2 = 0  # Tổng các vị trí i lẻ (nhân với 4)
    
    # Định nghĩa hàm tính x_i = a + i*h
    def x(i):
        return a + i * h
        
    for i in range(1, n):  # Dòng 2 - Thuật toán 15
        if i % 2 == 0:     # Dòng 3 - Thuật toán 15
            sum1 += 2 * f(x(i))  # Dòng 4 - Thuật toán 15
        else:
            sum2 += 4 * f(x(i))  # Dòng 6 - Thuật toán 15
            
    I_simpson = (h / 3) * (f(a) + sum1 + sum2 + f(b))  # Dòng 9 Thuật toán 15
    return I_simpson  # Dòng 10 - Thuật toán 15

