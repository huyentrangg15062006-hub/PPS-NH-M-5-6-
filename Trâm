import numpy as np
import numbers

# Bước 1: Kiểm tra điều kiện biên

def check_bounds(a, b):
    """
    Kiểm tra 2 cận tích phân a và b
    Require:
        a, b: Hai cận tích phân.
    Ensure:
        Trả về a, b dạng float nếu hợp lệ.
        Báo lỗi nếu a, b không phải số hữu hạn hoặc b nhỏ hơn a.
    """
    if isinstance(a, (bool, np.bool_)) or isinstance(b, (bool, np.bool_)):
        raise TypeError("a va b phai la so")
    if not isinstance(a, numbers.Real) or not isinstance(b, numbers.Real):
        raise TypeError("a va b phai la so thuc")
    if not np.isfinite(a) or not np.isfinite(b):
        raise ValueError("a va b phai la so huu han")
    a = float(a)
    b = float(b)
    if b < a:
        raise ValueError("Can tren phai lon hon hoac bang can duoi")
    return a, b

def eval_f(f, x):
    """
    Tính giá trị hàm số f tại điểm x
    Require:
        f:Hàm số cần tính.
        x: Giá trị đầu vào.
    Ensure:
        Trả về f(x) dạng float nếu hợp lệ.
        Báo lỗi nếu hàm không tính được, giắ trị không phải số hoặc không hữu hạn.
    """
    try:
        value = f(x)
    except Exception as e:
        raise ValueError("Không tính được f(x)") from e
    if isinstance(value, (bool, np.bool_)):
        raise TypeError("f(x) phải trả về giá trị số")
    if not isinstance(value, (numbers.Real, np.integer, np.floating)):
        raise TypeError("f(x) phải là số thực")
    if not np.isfinite(value):
        raise ValueError("f(x) Không được là NaN hoặc vô cùng")
    return float(value)

def check_result(result):
    """
    Kiểm tra kết quả tích phân
    Require:
        Giá trị kết quả cần kiểm tra
    Ensure:
        Trả về kết quả dạng số thực nếu hợp lệ
    """
    if not np.isfinite(result):
        raise OverflowError("Kết quả tính toán vô hạn")
    return float(result)

# Bước 2: Các hàm tính simpson phụ trợ

def simpson38_block(f, a, h, start):
    """
    Tính tích phân trên 3 khoảng đầu bằng phương pháp simpson 3/8
    Require:
        f: Hàm số.
        a: Cận dưới.
        h: Bước chia
        start: Vị trí bắt đầu của 3 khoảng.
    Ensure:
        Tính tích phân trên 3 khoảng bằng phương pháp Simpson 3/8
    """
    x0 = a + start * h
    x1 = a + (start + 1) * h
    x2 = a + (start + 2) * h
    x3 = a + (start + 3) * h
    result = (3 * h / 8) * (
        eval_f(f, x0)
        + 3 * eval_f(f, x1)
        + 3 * eval_f(f, x2)
        + eval_f(f, x3)
    )
    return check_result(result)

def simpson13_block(f, a, h, start, end):
    """
    Tính tích phân trên một số khoảng chẵn bằng phương pháp 1/3
    Require:
        f: Hàm số.
        a: Cận dưới.
        h: Bước chia.
        start, end: Vị trí đầu và cuối.
    Ensure:
        Trả về tích phân bằng phương pháp Simpson 1/3.
    """
    m = end - start
    if m < 2 or m % 2 != 0:
        raise ValueError("Simpson 1/3 can so khoang chia chan")
    total = eval_f(f, a + start * h)
    total += eval_f(f, a + end * h)
    for i in range(start + 1, end):
        x = a + i * h
        if (i - start) % 2 == 1:
            total += 4 * eval_f(f, x)
        else:
            total += 2 * eval_f(f, x)
    return check_result(h * total / 3)

def simpson38_values(ys, h, start):
    """
    Tính tích phân Simpson 3/8 từ bảng số liệu
    Require:
        ys: Mang giá trị hàm số.
        h: Bước chia.
        start: Vị trí bắt đầu.
    Ensure:
        Tra cứu tích phân Simpson 3/8 từ bảng số liệu.
    """
    result = (3 * h / 8) * (
        ys[start] + 3 * ys[start + 1]
        + 3 * ys[start + 2] + ys[start + 3]
    )
    return check_result(result)

def simpson13_values(ys, h, start, end):
    """
    Tính tich phân Simpson 1/3 từ bảng số liệu
    Require:
        ys: Mang giá trị hàm số.
        h: Bước chia.
        start, end: Vị trí đầu và cuối.
    Ensure:
        Trả về giátrij gần dúng của tích phân theo Simpson 1/3.
    """
    m = end - start
    if m < 2 or m % 2 != 0:
        raise ValueError("Simpson 1/3 can so khoang chia chan")
    total = ys[start] + ys[end]
    for i in range(start + 1, end):
        if (i - start) % 2 == 1:
            total += 4 * ys[i]
        else:
            total += 2 * ys[i]
    return check_result(h * total / 3)

# Bước 3: Hàm simpson 3/8 cơ bản

def simpson38(f, a, b) -> float:
    """
    Tính tích phân xác định bằng phương pháp Simpson 3/8.
    Chia khoảng [a,b] thành 3 khoảng bằng nhau và áp dụng công thức Simpson 3/8.
    Require:
        f: Hàm số cần tính tích phân.
        a: Cận dưới.
        b: Cận trên.
    Ensure:
        Tìm giá trị gần đúng của tích phân.
    """
    if not callable(f):
        raise TypeError("f phai la ham so")
    a, b = check_bounds(a, b)
    if a == b:
        return 0.0
    h = (b - a) / 3
    return simpson38_block(f, a, h, 0)

# Bước 4: Hàm simpson kết hợp

def simpson_mixed(f, a, b, n) -> float:
    """
    Tích phân bằng phương pháp Simpson kết hợp.
    Thuật toán:
     n chẵn: Simpson 1/3.
     n lẻ chia hết cho 3: Simpson 3/8.
     n lẻ không chia hết cho 3: Ghép Simpson 3/8 và Simpson 1/3.
    Require:
        f: Hàm số cần tính tích phân.
        a: Cận dưới.
        b: Cận trên.
        n: Số khoảng chia.
    Ensure:
        Trả về giá trị gần đúng của tích phân.
    """
    if not callable(f):
        raise TypeError("f phai la ham so")
    a, b = check_bounds(a, b)
    if isinstance(n, (bool, np.bool_)) or not isinstance(n, (int, np.integer)):
        raise TypeError("n phai la so nguyen")
    if n <= 0:
        raise ValueError("n phai la so nguyen duong")
    if a == b:
        return 0.0
    if n < 2:
        raise ValueError("n phai lon hon hoac bang 2")
    h = (b - a) / n

    # Truong hop n chan: Simpson 1/3
    if n % 2 == 0:
        return simpson13_block(f, a, h, 0, n)
    
    # Truong hop n le va chia het cho 3
    if n % 3 == 0:
        total = 0.0
        for i in range(0, n, 3):
            total += simpson38_block(f, a, h, i)
        return check_result(total)

    # Truong hop n le khong chia het cho 3
    total = simpson38_block(f, a, h, 0)
    total += simpson13_block(f, a, h, 3, n)
    return check_result(total)

# Bước 5: Hàm simpson từ bảng dữ liệu

def simpson_table(xs, ys) -> float:
    """
    Tinh tich phan tu bang so lieu (xs, ys).
     Thuật toán: Kiểm tra dữ liệu, tính bước chia, sau đó áp dụng quy tắc Simpson 1/3 hoặc 3/8, 
     Có thể kết hợp cả hai phương pháp nếu cần.
    Require:
        xs: Mảng các giá trị x.
        ys: Mảng các giá trị y tương ứng.
    Ensure:
       Trả về giá trị gần đúng của tích phân.
    """
    try:
        xs = np.asarray(xs, dtype=float)
        ys = np.asarray(ys, dtype=float)
    except (TypeError, ValueError, OverflowError) as e:
        raise TypeError("xs va ys phai chua cac gia tri so") from e

    # Kiem tra mang mot chieu
    if xs.ndim != 1 or ys.ndim != 1:
        raise ValueError("xs va ys phai la mang mot chieu")

    # Kiem tra so phan tu
    if len(xs) != len(ys):
        raise ValueError("xs va ys phai co cung so phan tu")
    if len(xs) < 3:
        raise ValueError("Can it nhat 3 diem de ap dung Simpson")

    # Kiem tra gia tri huu han
    if not np.all(np.isfinite(xs)) or not np.all(np.isfinite(ys)):
        raise ValueError("Du lieu khong duoc chua NaN hoac vo cung")

    # Kiem tra xs tang dan
    if np.any(np.diff(xs) <= 0):
        raise ValueError("Cac gia tri xs phai tang dan")

    # Kiem tra cac khoang chia bang nhau
    h_values = np.diff(xs)

    if not np.allclose(h_values, h_values[0], rtol=1e-9, atol=1e-12):
        raise ValueError("Cac diem xs phai cach deu nhau")
    h = h_values[0]
    n = len(xs) - 1

    # n chan: Simpson 1/3
    if n % 2 == 0:
        return simpson13_values(ys, h, 0, n)
    
    # n le chia het cho 3: Simpson 3/8
    if n % 3 == 0:
        total = 0.0
        for i in range(0, n, 3):
            total += simpson38_values(ys, h, i)
        return check_result(total)
    # n le khong chia het cho 3: ghep hai phuong phap
    total = simpson38_values(ys, h, 0)
    total += simpson13_values(ys, h, 3, n)
    return check_result(total)
