
import numpy as np
import numbers


# 1. Kiem tra dieu kien bien
def check_bounds(a, b):
    if not isinstance(a, numbers.Real) or not isinstance(b, numbers.Real):
        raise TypeError("Can tich phan phai la so.")

    if not np.isfinite(a) or not np.isfinite(b):
        raise ValueError("Can tich phan phai huu han.")

    if a >= b:
        raise ValueError("Can duoi phai nho hon can tren.")


# 2. Kiem tra so khoang chia
def check_n(n):
    if not isinstance(n, numbers.Integral) or isinstance(n, bool):
        raise TypeError("n phai la so nguyen.")

    if n < 2:
        raise ValueError("n phai lon hon hoac bang 2.")


# 3. Cong thuc Simpson 1/3
def simpson13(f, a, h, start, end):
    n = end - start

    if n <= 0 or n % 2 != 0:
        raise ValueError("Simpson 1/3 can so khoang chia chan.")

    s = f(a + start * h) + f(a + end * h)

    for i in range(start + 1, end):
        x = a + i * h

        if (i - start) % 2 == 1:
            s += 4 * f(x)
        else:
            s += 2 * f(x)

    return h * s / 3


# 4. Cong thuc Simpson 3/8
def simpson38(f, a, h, start):
    x0 = a + start * h
    x1 = a + (start + 1) * h
    x2 = a + (start + 2) * h
    x3 = a + (start + 3) * h

    return 3 * h / 8 * (
        f(x0) + 3 * f(x1) + 3 * f(x2) + f(x3)
    )


# 5. Tinh tich phan bang Simpson
def simpson_mixed(f, a, b, n):
    check_bounds(a, b)
    check_n(n)

    h = (b - a) / n

    # Truong hop n chan: Simpson 1/3
    if n % 2 == 0:
        return simpson13(f, a, h, 0, n)

    # Truong hop n = 3: Simpson 3/8
    if n == 3:
        return simpson38(f, a, h, 0)

    # Truong hop n le va n > 3:
    # 3 khoang dau dung Simpson 3/8
    # Cac khoang con lai dung Simpson 1/3
    return (
        simpson38(f, a, h, 0)
        + simpson13(f, a, h, 3, n)
    )


# 6. Tinh tich phan tu bang gia tri bang cach
def simpson_table(xs, ys):
    xs = np.asarray(xs, dtype=float)
    ys = np.asarray(ys, dtype=float)

    if xs.ndim != 1 or ys.ndim != 1:
        raise ValueError("Du lieu phai la mang mot chieu.")

    if len(xs) != len(ys):
        raise ValueError("Hai mang phai co cung so phan tu.")

    if len(xs) < 3:
        raise ValueError("Can it nhat 3 diem du lieu.")

    if not np.all(np.isfinite(xs)) or not np.all(np.isfinite(ys)):
        raise ValueError("Du lieu phai la cac so huu han.")

    h_values = np.diff(xs)

    if np.any(h_values <= 0):
        raise ValueError("Cac gia tri x phai tang dan.")

    if not np.allclose(h_values, h_values[0]):
        raise ValueError("Cac khoang chia phai bang nhau.")

    n = len(xs) - 1
    h = h_values[0]

    def f(x):
        index = round((x - xs[0]) / h)
        return ys[index]

    return simpson_mixed(f, xs[0], xs[-1], n)
