import numpy as np
def check_boundary(a, b, f=None):
    if not np.isfinite(a) or not np.isfinite(b):
        raise ValueError("Can a va b phai huu han.")
    if a >= b:
        raise ValueError("Can phai thoa man a < b.")
    if f is not None:
        for x in [a, b]:
            y = f(x)
            if not np.isfinite(y):
                raise ValueError("Gia tri ham tai bien khong hop le.")
def simpson38(f, a, b):
    """
    Mo ta:
        Tinh tich phan bang cong thuc Simpson 3/8 (5.16).
    Require:
        f: Ham so can tinh tich phan.
        a, b: Can duoi va can tren, thoa man a < b.
    Ensure:
        Tra ve gia tri gan dung cua tich phan.
    """
    if not np.isfinite(a) or not np.isfinite(b) or a >= b:
        raise ValueError("Can phai thoa man a < b va huu han.")

    h = (b - a) / 3
    return float(
        3 * h / 8
        * (f(a) + 3 * f(a + h) + 3 * f(a + 2 * h) + f(b))
    )

def _simpson38_composite(f, a, b, n):
    """
    Mo ta:
        Tinh tich phan bang Simpson 3/8 ghep.
    Require:
        n la so nguyen duong chia het cho 3.
    Ensure:
        Tra ve gia tri gan dung cua tich phan.
    """
    if not isinstance(n, (int, np.integer)) or isinstance(n, (bool, np.bool_)):
        raise TypeError("n phai la so nguyen.")
    if n <= 0 or n % 3 != 0:
        raise ValueError("n phai la so nguyen duong chia het cho 3.")
    h = (b - a) / n
    s = f(a) + f(b)
    for i in range(1, n):
        x = a + i * h
        if i % 3 == 0:
            s += 2 * f(x)
        else:
            s += 3 * f(x)
    return 3 * h * s / 8

def _simpson13(f, a, b, n):
    """
    Mo ta:
        Tinh tich phan bang Simpson 1/3 ghep.
    Require:
        n la so nguyen duong chan.
    Ensure:
        Tra ve gia tri gan dung cua tich phan.
    """
    if n <= 0 or n % 2 != 0:
        raise ValueError("Simpson 1/3 yeu cau n chan va duong.")
    h = (b - a) / n
    s = f(a) + f(b)
    for i in range(1, n):
        x = a + i * h
        if i % 2 == 0:
            s += 2 * f(x)
        else:
            s += 4 * f(x)
    return h * s / 3

def simpson_mixed(f, a, b, n):
    """
    Mo ta:
        Tinh tich phan bang Simpson 3/8 ket hop Simpson 1/3.
    Require:
        f: Ham so can tinh tich phan.
        a, b: Can duoi va can tren, thoa man a < b.
        n: So khoang chia nguyen duong.
    Ensure:
        Neu n chan, su dung Simpson 1/3.
        Neu n le, su dung Simpson 3/8 cho 3 khoang dau
        va Simpson 1/3 cho cac khoang con lai.
        Tra ve gia tri gan dung cua tich phan.
    """
    if not np.isfinite(a) or not np.isfinite(b) or a >= b:
        raise ValueError("Can phai thoa man a < b va huu han.")
    if not isinstance(n, (int, np.integer)) or isinstance(n, (bool, np.bool_)):
        raise TypeError("n phai la so nguyen.")
    if n <= 0:
        raise ValueError("n phai la so nguyen duong.")
    h = (b - a) / n
    if n % 2 == 0:
        return float(_simpson13(f, a, b, n))
    if n < 3:
        raise ValueError("n le phai lon hon hoac bang 3.")
    if n == 3:
        return float(simpson38(f, a, b))
    x = a + 3 * h
    return float(_simpson38_composite(f, a, x, 3)+ _simpson13(f, x, b, n - 3))

def _check_table(xs, ys):
    """
    Mo ta:
        Kiem tra du lieu bang tich phan.
    Require:
        xs, ys la hai day du lieu.
    Ensure:
    Hai day co cung do dai, cac diem xs tang dan
        va cach deu.
    """
    xs = np.asarray(xs, dtype=float)
    ys = np.asarray(ys, dtype=float)
    if xs.ndim != 1 or ys.ndim != 1:
        raise ValueError("xs va ys phai la day mot chieu.")
    if len(xs) != len(ys):
        raise ValueError("xs va ys phai co cung do dai.")

    if len(xs) < 4:
        raise ValueError("Can it nhat 4 diem du lieu.")
    if not np.all(np.isfinite(xs)) or not np.all(np.isfinite(ys)):
        raise ValueError("Du lieu khong duoc chua NaN hoac vo cuc.")
    h = np.diff(xs)
    if not np.all(h > 0):
        raise ValueError("xs phai tang dan.")
    if not np.allclose(h, h[0]):
        raise ValueError("Cac diem xs phai cach deu.")
    return xs, ys

def _simpson13_table(ys, h):
    """
    Mo ta:
        Tinh Simpson 1/3 ghep tu bang du lieu.
    Require:
        ys la day gia tri ham.
        h la khoang cach giua hai diem lien tiep.
        So khoang chia chan va duong.
    Ensure:
        Tra ve gia tri gan dung cua tich phan.
    """
    n = len(ys) - 1
    if n <= 0 or n % 2 != 0:
        raise ValueError("Simpson 1/3 yeu cau so khoang chan.")
    s = ys[0] + ys[-1]
    for i in range(1, n):
        if i % 2 == 0:
            s += 2 * ys[i]
        else:
            s += 4 * ys[i]
    return h * s / 3

def _simpson38_table(ys, h):
    """
    Mo ta:
        Tinh Simpson 3/8 ghep tu bang du lieu.
    Require:
        ys la day gia tri ham.
        h la khoang cach giua hai diem lien tiep.
        So khoang chia chia het cho 3.
    Ensure:
        Tra ve gia tri gan dung cua tich phan.
    """
    n = len(ys) - 1
    if n <= 0 or n % 3 != 0:
        raise ValueError("Simpson 3/8 yeu cau so khoang chia het cho 3.")
    s = ys[0] + ys[-1]
    for i in range(1, n):
        if i % 3 == 0:
            s += 2 * ys[i]
        else:
            s += 3 * ys[i]
    return 3 * h * s / 8

def simpson_table(xs, ys):
    """
        Tinh tich phan tu bang du lieu bang Simpson.
    Require:
        xs, ys la hai day du lieu cung do dai.
        xs tang dan va cach deu.
        Co it nhat 4 diem du lieu.
    Ensure:
        Neu so khoang chan, dung Simpson 1/3.
        Neu so khoang le, dung Simpson 3/8 cho 3 khoang dau
        va Simpson 1/3 cho cac khoang con lai.
        Tra ve gia tri gan dung cua tich phan.
    """
    xs, ys = _check_table(xs, ys)
    n = len(xs) - 1
    h = (xs[-1] - xs[0]) / n
    if n % 2 == 0:
        return float(_simpson13_table(ys, h))
    if n == 3:
        return float(_simpson38_table(ys[:4], h)+ _simpson13_table(ys[3:], h))
